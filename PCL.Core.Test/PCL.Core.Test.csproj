<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <Configurations>Debug;CI;Release;Beta</Configurations>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <AssemblyTitle>PCL.Test</AssemblyTitle>
    <Product>PCL.Test</Product>
    <Copyright>Copyright © PCL Community 2025</Copyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <PropertyGroup>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\</OutputPath>
    <PlatformTarget>$(Platform)</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Beta' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'CI' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="fNbt" Version="1.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="Microsoft.TestPlatform.AdapterUtilities" Version="18.7.0" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="18.7.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.3.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.3.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PCL.Core\PCL.Core.csproj" />
    <ProjectReference Include="..\PCL.Plugin.SDK\PCL.Plugin.SDK.csproj" />
    <ProjectReference Include="..\PCL.Plugin.Dependency.TestSupport\PCL.Plugin.Dependency.TestSupport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Net\**" />
    <Compile Include="..\Plain Craft Launcher 2\Controls\LiquidGlassMath.cs" Link="UI\LiquidGlassMath.cs" />
    <Compile Include="..\Plain Craft Launcher 2\Controls\LiquidGlassSurface.cs" Link="UI\LiquidGlassSurface.cs" />
    <Compile Include="..\Plain Craft Launcher 2\Controls\LiquidGlassEffect.cs" Link="UI\LiquidGlassEffect.cs" />
    <Compile Include="..\Plain Craft Launcher 2\Modules\UI\Theme\LiquidGlassCaptureContracts.cs" Link="UI\LiquidGlassCaptureContracts.cs" />
    <Compile Include="..\Plain Craft Launcher 2\Modules\UI\Theme\LiquidGlassDesktopCapture.cs" Link="UI\LiquidGlassDesktopCapture.cs" />
    <Resource Include="..\Plain Craft Launcher 2\Resources\LiquidGlass\Glass.ps" Link="Resources\LiquidGlass\Glass.ps" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Net\**" />
  </ItemGroup>
  <ItemGroup>
    <Page Remove="Net\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Net\**" />
  </ItemGroup>
</Project>
