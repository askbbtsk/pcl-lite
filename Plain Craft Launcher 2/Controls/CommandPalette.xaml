<UserControl x:Class="PCL.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PCL"
             Visibility="Collapsed" Focusable="False"
             KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
             FontFamily="{DynamicResource LaunchFontFamily}" FontSize="14"
             Foreground="{DynamicResource ColorBrush1}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ColorBrushSemiTransparent">#01eaf2fe</SolidColorBrush>
    </UserControl.Resources>
    <Grid Background="#66000000" MouseDown="Backdrop_MouseDown">
        <Border x:Name="Surface" MaxWidth="600" Margin="24" Padding="20" CornerRadius="12"
                VerticalAlignment="Center" Background="{DynamicResource ColorBrushBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,14">
                    <local:MyButton x:Name="CloseButton" DockPanel.Dock="Right" Text="Esc"
                                    Height="30" MinWidth="52" Padding="10,0" VerticalAlignment="Center"
                                    Click="Close_Click"
                                    ToolTip="{DynamicResource CommandPalette.Close}"
                                    AutomationProperties.Name="{DynamicResource CommandPalette.Close}" />
                    <TextBlock Text="{DynamicResource CommandPalette.Title}" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
                <local:MyTextBox x:Name="Query" Grid.Row="1" Height="40" Padding="10,0" MaxLength="200"
                                 Background="{DynamicResource ColorBrushBackground}" CaretBrush="{DynamicResource ColorBrush1}"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 HintText="{DynamicResource CommandPalette.Hint}"
                                 AutomationProperties.Name="{DynamicResource CommandPalette.Hint}"
                                 TextChanged="Query_TextChanged" />
                <Grid Grid.Row="2" MinHeight="72">
                    <ScrollViewer x:Name="ResultsScroll"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Focusable="False"
                                  AutomationProperties.Name="{DynamicResource CommandPalette.Results}">
                        <StackPanel x:Name="Results" />
                    </ScrollViewer>
                    <TextBlock x:Name="Empty" Text="{DynamicResource CommandPalette.Empty}" Visibility="Collapsed"
                               TextWrapping="Wrap" Margin="10,16" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="Status" Grid.Row="3" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                           Text="{DynamicResource CommandPalette.Keys}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
