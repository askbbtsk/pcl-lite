<local:MyPageRight x:Class="PCL.PageBedrockDownload"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="{DynamicResource Bedrock.Download.List.Title}">
                <StackPanel Margin="20,38,20,12">
                    <WrapPanel Margin="6,0,6,4">
                        <local:MyButton x:Name="BtnRefresh" Height="30" Padding="12,0" Margin="0,0,8,6"
                                        Text="{DynamicResource Common.Action.Refresh}" Click="BtnRefresh_Click" />
                        <local:MyButton x:Name="BtnOpenFolder" Height="30" Padding="12,0" Margin="0,0,8,6"
                                        Text="{DynamicResource Bedrock.Download.OpenFolder}" Click="BtnOpenFolder_Click" />
                        <local:MyButton x:Name="BtnChooseDir" Height="30" Padding="12,0" Margin="0,0,0,6"
                                        Text="{DynamicResource Bedrock.Download.ChooseDir}" Click="BtnChooseDir_Click" />
                    </WrapPanel>
                    <Grid Margin="6,0,6,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Bedrock.Download.Filter.Channel}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.8" />
                        <local:MyComboBox Grid.Column="1" x:Name="ComboChannel" MinWidth="94" Height="28"
                                          SelectionChanged="ComboFilter_Changed">
                            <local:MyComboBoxItem Content="{DynamicResource Common.Option.All}" Tag="0" IsSelected="True" />
                            <local:MyComboBoxItem Content="{DynamicResource Bedrock.Channel.Release}" Tag="1" />
                            <local:MyComboBoxItem Content="{DynamicResource Bedrock.Channel.Preview}" Tag="2" />
                            <local:MyComboBoxItem Content="{DynamicResource Bedrock.Channel.Beta}" Tag="3" />
                        </local:MyComboBox>
                        <local:MyComboBox Grid.Column="2" x:Name="ComboKind" MinWidth="94" Height="28"
                                          Margin="12,0,0,0"
                                          SelectionChanged="ComboFilter_Changed">
                            <local:MyComboBoxItem Content="{DynamicResource Bedrock.Download.Filter.AllPackages}" Tag="0" IsSelected="True" />
                            <local:MyComboBoxItem Content="UWP" Tag="1" />
                            <local:MyComboBoxItem Content="GDK" Tag="2" />
                        </local:MyComboBox>
                        <!--
                            搜索框不能写死 Width + 右对齐：它所在的列是 *，窄窗口（820 / 850）下
                            列宽会小于写死的宽度，右对齐的控件于是往左溢出，直接压在左边的
                            「全部」下拉框上。交给 * 列自己撑开就不会重叠。
                        -->
                        <local:MyTextBox Grid.Column="3" x:Name="TextSearch" Height="28"
                                         Margin="12,0,0,0"
                                         HintText="{DynamicResource Bedrock.Download.Filter.Search}"
                                         TextChanged="TextSearch_TextChanged" />
                    </Grid>

                    <TextBlock x:Name="LabStatus" Margin="6,0,6,6" FontSize="12"
                               TextWrapping="Wrap" Opacity="0.8"
                               Text="{DynamicResource Bedrock.Download.Status.Idle}" />

                    <ItemsControl x:Name="ListVersions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="62" Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,6,12,6" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding Title}" TextWrapping="Wrap" />
                                        <WrapPanel Margin="0,3,0,0">
                                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="0,0,10,0" Text="{Binding Subtitle}" />
                                            <TextBlock FontSize="11.5" Opacity="0.75" Margin="0,0,10,0" Text="{Binding Badge}" />
                                            <TextBlock FontSize="11.5" Opacity="0.85" TextWrapping="Wrap" Text="{Binding Status}" />
                                        </WrapPanel>
                                        <Grid Width="220" Height="4" Margin="0,6,0,0" HorizontalAlignment="Left"
                                              Visibility="{Binding ProgressVisibility}">
                                            <Border Background="{DynamicResource ColorBrushGray4}" Opacity="0.3" CornerRadius="2" />
                                            <Border Background="{DynamicResource ColorBrush3}" CornerRadius="2"
                                                    HorizontalAlignment="Left" Width="{Binding ProgressWidth}" />
                                        </Grid>
                                    </StackPanel>
                                    <local:MyButton Grid.Column="1" MinWidth="110" Padding="10,0" Height="30"
                                                    VerticalAlignment="Center" ColorType="Highlight"
                                                    Text="{Binding ActionText}" IsEnabled="{Binding CanStart}"
                                                    Tag="{Binding}" Click="BtnAction_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LabEmpty" Margin="6,10" Opacity="0.7" TextWrapping="Wrap"
                               Text="{DynamicResource Bedrock.Download.Empty}" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
