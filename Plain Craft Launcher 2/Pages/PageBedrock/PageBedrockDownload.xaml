<local:MyPageRight x:Class="PCL.PageBedrockDownload"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="{DynamicResource Bedrock.Download.Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{DynamicResource Bedrock.Download.Description}" TextWrapping="Wrap" LineHeight="20" />
                    <WrapPanel Margin="0,15,0,0" ItemHeight="35">
                        <local:MyButton x:Name="BtnRefresh" MinWidth="120" Margin="0,0,12,0"
                                        Text="{DynamicResource Bedrock.Download.Refresh}" Click="BtnRefresh_Click" />
                        <local:MyButton x:Name="BtnOpenFolder" MinWidth="130" Margin="0,0,12,0"
                                        Text="{DynamicResource Bedrock.Download.OpenFolder}" Click="BtnOpenFolder_Click" />
                        <local:MyButton x:Name="BtnDeveloperMode" MinWidth="150"
                                        Text="{DynamicResource Bedrock.Download.DeveloperMode}"
                                        Click="BtnDeveloperMode_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="LabStatus" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap" Opacity="0.7"
                               Text="{DynamicResource Bedrock.Download.Status.Idle}" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Bedrock.Download.List.Title}">
                <StackPanel Margin="20,40,20,15">
                    <Grid Margin="6,0,6,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource Bedrock.Download.Filter.Channel}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0.8" />
                        <local:MyComboBox Grid.Column="1" x:Name="ComboChannel" MinWidth="120" Height="28"
                                          SelectionChanged="ComboFilter_Changed">
                            <local:MyComboBoxItem Content="{DynamicResource Common.Option.All}" Tag="0" IsSelected="True" />
                            <local:MyComboBoxItem Content="{DynamicResource Bedrock.Channel.Release}" Tag="1" />
                            <local:MyComboBoxItem Content="{DynamicResource Bedrock.Channel.Preview}" Tag="2" />
                            <local:MyComboBoxItem Content="{DynamicResource Bedrock.Channel.Beta}" Tag="3" />
                        </local:MyComboBox>
                        <local:MyComboBox Grid.Column="2" x:Name="ComboKind" MinWidth="120" Height="28"
                                          Margin="12,0,0,0"
                                          SelectionChanged="ComboFilter_Changed">
                            <local:MyComboBoxItem Content="{DynamicResource Common.Option.All}" Tag="0" IsSelected="True" />
                            <local:MyComboBoxItem Content="UWP" Tag="1" />
                            <local:MyComboBoxItem Content="GDK" Tag="2" />
                        </local:MyComboBox>
                        <local:MyTextBox Grid.Column="3" x:Name="TextSearch" Width="170" Height="28"
                                         HorizontalAlignment="Right" HintText="{DynamicResource Bedrock.Download.Filter.Search}"
                                         TextChanged="TextSearch_TextChanged" />
                    </Grid>

                    <ItemsControl x:Name="ListVersions">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="6,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="8,0,0,0" FontSize="11.5" Opacity="0.6"
                                                       VerticalAlignment="Center" Text="{Binding Badge}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Opacity="0.65"
                                                   Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                        <Grid Width="220" Height="4" Margin="0,6,0,0" HorizontalAlignment="Left"
                                              Visibility="{Binding ProgressVisibility}">
                                            <Border Background="{DynamicResource ColorBrushGray4}" Opacity="0.3"
                                                    CornerRadius="2" />
                                            <Border Background="{DynamicResource ColorBrush3}" CornerRadius="2"
                                                    HorizontalAlignment="Left" Width="{Binding ProgressWidth}" />
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="0,0,12,0" FontSize="11.5" Opacity="0.65"
                                               VerticalAlignment="Center" Text="{Binding Status}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    <local:MyButton Grid.Column="2" Width="110" Height="30" VerticalAlignment="Center"
                                                    ColorType="Highlight" Text="{Binding ActionText}"
                                                    Tag="{Binding}" Click="BtnAction_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LabEmpty" Margin="6,10" Opacity="0.7" TextWrapping="Wrap"
                               Text="{DynamicResource Bedrock.Download.Empty}" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
