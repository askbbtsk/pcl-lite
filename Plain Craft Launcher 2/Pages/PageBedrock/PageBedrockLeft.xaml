<local:MyPageLeft x:Class="PCL.PageBedrockLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d">
    <StackPanel Orientation="Vertical" x:Name="PanItem" Margin="0,12,0,0">

        <TextBlock Text="{DynamicResource Bedrock.Left.Category}"
                   Margin="13,5,5,3"
                   Opacity="0.6" FontSize="12"
                   x:Name="TextBedrockCategory" />

        <local:MyListItem x:Name="ItemDownload"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="0"
                          Check="PageCheck"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Bedrock.Left.Download}"
                          LogoScale="0.85"
                          SvgIcon="lucide/download" />

        <local:MyListItem x:Name="ItemLaunch"
                          IsScaleAnimationEnabled="False"
                          Type="RadioBox" Tag="1"
                          Check="PageCheck"
                          MinPaddingRight="35" Height="36"
                          VerticalAlignment="Top"
                          Title="{DynamicResource Bedrock.Left.Launch}"
                          LogoScale="0.85"
                          SvgIcon="lucide/play" />

    </StackPanel>
</local:MyPageLeft>
