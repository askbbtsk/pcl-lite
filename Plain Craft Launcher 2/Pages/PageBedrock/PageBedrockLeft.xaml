<local:MyPageLeft x:Class="PCL.PageBedrockLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d"
                  Width="260">
    <!--
        宽度必须写死。FormMain 里这一列是 Width="Auto"，左栏不自己定宽就会按内容撑开：
        状态里出现一句长的失败原因（比如「安装失败：没能拿到 xxx 的下载地址…」），
        整块左栏能涨到 800 多像素，把右边页面压成一条缝，版本列表只剩「未下载」两个字。
        ScrollViewer 横向禁用时也不会给子元素宽度约束，TextWrapping 因此形同虚设。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <!-- 上半部分：子页面切换 + 状态卡片，内容多时可以滚动 -->
        <local:MyScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" x:Name="PanItem" Margin="0,12,0,0">

                <TextBlock Text="{DynamicResource Bedrock.Left.Category}"
                           Margin="13,5,5,3"
                           Opacity="0.6" FontSize="12"
                           x:Name="TextBedrockCategory" />

                <local:MyListItem x:Name="ItemDownload"
                                  IsScaleAnimationEnabled="False"
                                  Type="RadioBox" Tag="0"
                                  Check="PageCheck"
                                  MinPaddingRight="35" Height="36"
                                  VerticalAlignment="Top"
                                  Title="{DynamicResource Bedrock.Left.Download}"
                                  LogoScale="0.85"
                                  SvgIcon="lucide/download" />

                <local:MyListItem x:Name="ItemLaunch"
                                  IsScaleAnimationEnabled="False"
                                  Type="RadioBox" Tag="1"
                                  Check="PageCheck"
                                  MinPaddingRight="35" Height="36"
                                  VerticalAlignment="Top"
                                  Title="{DynamicResource Bedrock.Left.Launch}"
                                  LogoScale="0.85"
                                  SvgIcon="lucide/play" />

                <!-- 基岩版状态：圆点 + 标题 + 详情，由 ModBedrockRuntime 驱动 -->
                <TextBlock Text="{DynamicResource Bedrock.Status.Title}"
                           Margin="13,10,5,4" Opacity="0.6" FontSize="12" />
                <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                        CornerRadius="5" Padding="12,10">
                    <StackPanel>
                        <!--
                            用 Grid 而不是水平 StackPanel：StackPanel 横向不给子元素宽度约束，
                            里面的 TextBlock 永远不会换行，只能被裁掉。
                        -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ShapeStatusDot" Grid.Column="0"
                                     Width="8" Height="8" Margin="0,0,7,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource ColorBrushGray4}" />
                            <!--
                                允许换行（版本名长的时候能看到完整内容），但用 MaxHeight 封顶：
                                解包时这里每秒刷好几次，不限高的话整块左栏会跟着文字上下跳。
                                失败原因往往有两三行，所以留 3 行的高度；再多就靠 ToolTip 看全文。
                            -->
                            <TextBlock x:Name="LabStatus" Grid.Column="1"
                                       FontSize="13" FontWeight="Bold"
                                       TextWrapping="Wrap" MaxHeight="54"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Text="{DynamicResource Bedrock.Launch.Detecting}" />
                        </Grid>
                        <TextBlock x:Name="LabDetail" Text="" FontSize="10.5" Margin="15,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="42" LineHeight="14"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Opacity="0.65" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </local:MyScrollViewer>

        <!-- 左下角启动按钮，底部叠一行当前版本名 -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <local:MyButton x:Name="BtnLaunch" Height="54" Margin="20,0"
                            Text="{DynamicResource Bedrock.Launch.Title}"
                            ColorType="Highlight"
                            Click="BtnLaunch_Click"
                            Padding="30,0,30,15" />
            <TextBlock x:Name="LabVersionText" Text="" Margin="35,0,35,10"
                       IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11" Opacity="0.65" />
        </Grid>
    </Grid>
</local:MyPageLeft>
