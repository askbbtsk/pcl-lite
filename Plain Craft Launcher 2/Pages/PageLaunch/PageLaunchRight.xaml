<local:MyPageRight x:Class="PCL.PageLaunchRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"> <!-- 不知道为啥只有这个文件不能在 XAML 设置 PanScroll -->
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Name="PanMain" Margin="25,25,25,10" Grid.IsSharedSizeScope="True">
            <StackPanel x:Name="PanCustom" />
            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Launch.Right.Log.Title}" x:Name="PanLog">
                <!-- 用只读文本框而不是 TextBlock：日志长了可以滚动，也能选中复制报错信息 -->
                <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4"
                                 MaxHeight="240" IsReadOnly="True" IsUndoEnabled="False"
                                 AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0"
                                 HasBackground="False" VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>