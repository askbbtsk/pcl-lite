<local:MyPageRight x:Class="PCL.PageLunarLaunch"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <!--
        文案暂时直接写中文：这是 nightly 里的实验特性，等协议稳定后再补四语言键，
        免得先加一堆键、后面改协议又要全删一遍。
    -->
    <local:MyScrollViewer x:Name="PanBack" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!--  启动  -->
            <local:MyCard Margin="0,15" Title="启动">
                <StackPanel Margin="20,40,20,18">

                    <!--  状态行：圆点 + 主状态 + 补充说明  -->
                    <Grid Margin="6,0,6,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ShapeDot" Grid.Column="0"
                                 Width="9" Height="9" Margin="0,4,10,0"
                                 VerticalAlignment="Top"
                                 Fill="{DynamicResource ColorBrushGray4}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="LabStatusLine" FontSize="13.5" FontWeight="Bold"
                                       TextWrapping="Wrap" Text="正在检测 Lunar Client…" />
                            <TextBlock x:Name="LabStatusDetail" FontSize="11" Opacity="0.62"
                                       Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" Text="" />
                        </StackPanel>
                    </Grid>

                    <!--  选择区 + 信息块：标签与值分列，值过长时省略并用 ToolTip 显示全文  -->
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            CornerRadius="5" Padding="14,12" Margin="6,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  版本  -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="游戏版本"
                                       VerticalAlignment="Center"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,9" />
                            <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboVersion"
                                              Height="28" Margin="0,0,10,9"
                                              SelectionChanged="ComboVersion_SelectionChanged"
                                              ToolTip="Lunar 服务端当前提供的全部子版本，选完立即生效。" />
                            <local:MyButton Grid.Row="0" Grid.Column="2" x:Name="BtnRefreshVersions"
                                            Height="28" MinWidth="72" Margin="0,0,0,9"
                                            Text="刷新列表" Click="BtnRefreshVersions_Click" />

                            <!--  账号  -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="账号"
                                       VerticalAlignment="Center"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,9" />
                            <local:MyComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                              x:Name="ComboAccount" Height="28" Margin="0,0,0,9"
                                              SelectionChanged="ComboAccount_SelectionChanged"
                                              ToolTip="来自 Lunar 自己的账户库。进游戏用的是 Lunar 的激活账号，选完会同步过去。" />

                            <!--  启动目录  -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="启动目录"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,7" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LabGameDir"
                                       FontSize="11.5" Margin="0,0,0,7"
                                       TextTrimming="CharacterEllipsis" Text=""
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <!--  物料目录  -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="物料目录"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,7" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LabCacheDir"
                                       FontSize="11.5" Margin="0,0,0,7"
                                       TextTrimming="CharacterEllipsis" Text=""
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <!--  Java  -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Java"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LabJava"
                                       FontSize="11.5" TextTrimming="CharacterEllipsis" Text="启动后自动定位"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </Border>

                    <!--
                        账号状态的说明单独占一行并自动换行。
                        以前把「（会话已过期）」塞在下拉框内容里，文字一长就把右边的
                        按钮和日志挤歪；换行文本放在这里，多长都只往下长。
                    -->
                    <TextBlock x:Name="LabAccountHint" Margin="6,8,6,0" FontSize="11"
                               Opacity="0.7" TextWrapping="Wrap" LineHeight="15"
                               Visibility="Collapsed" Text="" />

                    <WrapPanel Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnLaunch" Height="35" MinWidth="130" Margin="0,0,12,0"
                                        ColorType="Highlight" Text="启动 Lunar" Click="BtnLaunch_Click" />
                        <local:MyButton x:Name="BtnOpenRoot" Height="35" MinWidth="130" Margin="0,0,12,0"
                                        Text="打开物料目录" Click="BtnOpenRoot_Click" />
                        <local:MyButton x:Name="BtnCopyCommand" Height="35" MinWidth="130"
                                        Text="复制启动命令" Click="BtnCopyCommand_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <!--  说明  -->
            <local:MyCard Margin="0,15" Title="说明">
                <StackPanel Margin="20,40,20,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="不经过 Lunar 启动器，由 PCL 直接拉起游戏进程。物料清单向 Lunar 服务端实时获取，1.7.10 到 26.x 的版本列表以服务端返回为准，启动方式完全一致。" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="账号用的是 Lunar 自己账户库里的账号（settings/game/accounts.json 的激活账号）。在这里切换会把 Lunar 的激活账号一并改掉，效果等同于在 Lunar 启动器里换号；Lunar 账户库为空时才回落到 PCL 主页面的登录凭据。" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="游戏目录跟随主页面当前选中的实例（版本隔离目录），与正常启动完全一致，不会把存档写进 .minecraft 根目录。" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="前置条件：本机已安装 Lunar Client 并至少启动过一次，让物料落盘。缺对应版本的 Java 时会自动下载（1.8.9～1.20.1 用 Java 17，1.20.6～1.21.11 用 Java 21，26.x 用 Java 25）。" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="账号下拉框分两组：PCL Lite 登录账号来自启动器自己的档案，Lunar 启动器账号来自 Lunar 的账户库。选 PCL 账号时会把 Lunar 的激活账号一并切到同一个 UUID（找不到同名账号就只换命令行令牌）。列出来只是读本地文件，不会触发重新登录。" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.6" FontSize="11.5"
                               Text="会话过期不用管：游戏会通过本地 IPC 的 AuthService/RefreshAccount 找启动器续期，PCL 启动前会抢占 127.0.0.1:28190 自己应答（Lunar 启动器开着时让位给它）。好友与社交面板仍未实现。" />
                </StackPanel>
            </local:MyCard>

            <!--  运行日志  -->
            <local:MyCard Margin="0,15" Title="运行日志">
                <StackPanel Margin="20,40,20,18">
                    <Grid Margin="6,0,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.55"
                                   Text="启动阶段与游戏输出（可直接选中复制）" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <local:MyButton x:Name="BtnCopyLog" Height="24" MinWidth="60" Margin="0,0,8,0"
                                            Text="复制" Click="BtnCopyLog_Click" />
                            <local:MyButton x:Name="BtnExportLog" Height="24" MinWidth="60" Margin="0,0,8,0"
                                            Text="导出" Click="BtnExportLog_Click" />
                            <local:MyButton x:Name="BtnClearLog" Height="24" MinWidth="60"
                                            Text="清空" Click="BtnClearLog_Click" />
                        </StackPanel>
                    </Grid>

                    <!--
                        这里刻意不用 MyScrollViewer：它的模板里只有纵向滚动条
                        （CanHorizontallyScroll=False），长行会被直接切掉、也拖不出来。
                        TextBox 自己的模板两条滚动条都有，而且不套一层 ScrollViewer
                        才不会把左键拖动选中抢走。
                    -->
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            CornerRadius="5" Padding="10">
                        <TextBox x:Name="TextLog" Height="230" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontFamily="Consolas" FontSize="11.5"
                                 Foreground="{DynamicResource ColorBrush1}"
                                 CaretBrush="{DynamicResource ColorBrush1}"
                                 SelectionBrush="{DynamicResource ColorBrush2}"
                                 IsReadOnlyCaretVisible="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
