<local:MyPageRight x:Class="PCL.PageLunarLaunch"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!--  启动  -->
            <local:MyCard Margin="0,15" Title="{DynamicResource Lunar.Card.Launch}">
                <StackPanel Margin="20,40,20,18">

                    <!--  状态行：圆点 + 主状态 + 补充说明  -->
                    <Grid Margin="6,0,6,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ShapeDot" Grid.Column="0"
                                 Width="9" Height="9" Margin="0,4,10,0"
                                 VerticalAlignment="Top"
                                 Fill="{DynamicResource ColorBrushGray4}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="LabStatusLine" FontSize="13.5" FontWeight="Bold"
                                       TextWrapping="Wrap" Text="{DynamicResource Lunar.Left.Detecting}" />
                            <TextBlock x:Name="LabStatusDetail" FontSize="11" Opacity="0.62"
                                       Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" Text="" />
                        </StackPanel>
                    </Grid>

                    <!--  选择区 + 信息块：标签与值分列，值过长时省略并用 ToolTip 显示全文  -->
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            CornerRadius="5" Padding="14,12" Margin="6,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  版本  -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Lunar.Field.Version}"
                                       VerticalAlignment="Center"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,9" />
                            <local:MyComboBox Grid.Row="0" Grid.Column="1" x:Name="ComboVersion"
                                              Height="28" Margin="0,0,10,9"
                                              SelectionChanged="ComboVersion_SelectionChanged"
                                              ToolTip="{DynamicResource Lunar.Tip.Version}" />
                            <local:MyButton Grid.Row="0" Grid.Column="2" x:Name="BtnRefreshVersions"
                                            Height="28" MinWidth="72" Margin="0,0,0,9"
                                            Text="{DynamicResource Lunar.Action.Refresh}" Click="BtnRefreshVersions_Click" />

                            <!--
                                Loader：每个版本能选的注入方案不一样（OptiFine / 原版 / Fabric / Forge），
                                由服务端 modules 决定，这里按服务端返回动态生成可点击的胶囊按钮。
                                选中的那个直接决定启动时请求哪份物料清单。
                            -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Loader"
                                       VerticalAlignment="Center"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,9" />
                            <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       x:Name="PanLoaders" Margin="0,0,0,9" />

                            <!--  账号  -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Lunar.Left.Account}"
                                       VerticalAlignment="Center"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,9" />
                            <local:MyComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                              x:Name="ComboAccount" Height="28" Margin="0,0,0,9"
                                              SelectionChanged="ComboAccount_SelectionChanged"
                                              ToolTip="{DynamicResource Lunar.Tip.Account}" />

                            <!--  启动目录  -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Lunar.Field.GameDir}"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,7" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LabGameDir"
                                       FontSize="11.5" Margin="0,0,0,7"
                                       TextTrimming="CharacterEllipsis" Text=""
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <!--  物料目录  -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Lunar.Field.CacheDir}"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,7" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LabCacheDir"
                                       FontSize="11.5" Margin="0,0,0,7"
                                       TextTrimming="CharacterEllipsis" Text=""
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <!--  Java  -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Java"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" x:Name="LabJava"
                                       FontSize="11.5" TextTrimming="CharacterEllipsis" Text="{DynamicResource Lunar.Field.JavaAuto}"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </Border>

                    <!--
                        账号状态的说明单独占一行并自动换行。
                        以前把「（会话已过期）」塞在下拉框内容里，文字一长就把右边的
                        按钮和日志挤歪；换行文本放在这里，多长都只往下长。
                    -->
                    <TextBlock x:Name="LabAccountHint" Margin="6,8,6,0" FontSize="11"
                               Opacity="0.7" TextWrapping="Wrap" LineHeight="15"
                               Visibility="Collapsed" Text="" />

                    <WrapPanel Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnLaunch" Height="35" MinWidth="130" Margin="0,0,12,0"
                                        ColorType="Highlight" Text="{DynamicResource Lunar.Launch}" Click="BtnLaunch_Click" />
                        <local:MyButton x:Name="BtnOpenRoot" Height="35" MinWidth="130" Margin="0,0,12,0"
                                        Text="{DynamicResource Lunar.Action.OpenDir}" Click="BtnOpenRoot_Click" />
                        <local:MyButton x:Name="BtnCopyCommand" Height="35" MinWidth="130"
                                        Text="{DynamicResource Lunar.Action.CopyCommand}" Click="BtnCopyCommand_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <!--  说明  -->
            <local:MyCard Margin="0,15" Title="{DynamicResource Lunar.Card.Notes}">
                <StackPanel Margin="20,40,20,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="{DynamicResource Lunar.Note.1}" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="{DynamicResource Lunar.Note.2}" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="{DynamicResource Lunar.Note.3}" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="{DynamicResource Lunar.Note.4}" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="{DynamicResource Lunar.Note.5}" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="{DynamicResource Lunar.Note.6}" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="{DynamicResource Lunar.Note.7}" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.6" FontSize="11.5"
                               Text="{DynamicResource Lunar.Note.8}" />
                </StackPanel>
            </local:MyCard>

            <!--  运行日志  -->
            <local:MyCard Margin="0,15" Title="{DynamicResource Lunar.Card.Log}">
                <StackPanel Margin="20,40,20,18">
                    <Grid Margin="6,0,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.55"
                                   Text="{DynamicResource Lunar.Log.Desc}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <local:MyButton x:Name="BtnCopyLog" Height="24" MinWidth="60" Margin="0,0,8,0"
                                            Text="{DynamicResource Lunar.Action.Copy}" Click="BtnCopyLog_Click" />
                            <local:MyButton x:Name="BtnExportLog" Height="24" MinWidth="60" Margin="0,0,8,0"
                                            Text="{DynamicResource Lunar.Action.Export}" Click="BtnExportLog_Click" />
                            <local:MyButton x:Name="BtnClearLog" Height="24" MinWidth="60"
                                            Text="{DynamicResource Lunar.Action.Clear}" Click="BtnClearLog_Click" />
                        </StackPanel>
                    </Grid>

                    <!--
                        这里刻意不用 MyScrollViewer：它的模板里只有纵向滚动条
                        （CanHorizontallyScroll=False），长行会被直接切掉、也拖不出来。
                        TextBox 自己的模板两条滚动条都有，而且不套一层 ScrollViewer
                        才不会把左键拖动选中抢走。
                    -->
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            CornerRadius="5" Padding="10">
                        <TextBox x:Name="TextLog" Height="230" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" FontFamily="Consolas" FontSize="11.5"
                                 Foreground="{DynamicResource ColorBrush1}"
                                 CaretBrush="{DynamicResource ColorBrush1}"
                                 SelectionBrush="{DynamicResource ColorBrush2}"
                                 IsReadOnlyCaretVisible="True" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" />
                    </Border>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
