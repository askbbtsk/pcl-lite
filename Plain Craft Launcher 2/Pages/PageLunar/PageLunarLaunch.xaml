<local:MyPageRight x:Class="PCL.PageLunarLaunch"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <!--
        文案暂时直接写中文：这是 nightly 里的实验特性，等协议稳定后再补四语言键，
        免得先加一堆键、后面改协议又要全删一遍。
    -->
    <local:MyScrollViewer x:Name="PanBack" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!--  启动  -->
            <local:MyCard Margin="0,15" Title="启动">
                <StackPanel Margin="20,40,20,18">

                    <!--  状态行：圆点 + 主状态 + 补充说明  -->
                    <Grid Margin="6,0,6,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ShapeDot" Grid.Column="0"
                                 Width="9" Height="9" Margin="0,4,10,0"
                                 VerticalAlignment="Top"
                                 Fill="{DynamicResource ColorBrushGray4}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="LabStatusLine" FontSize="13.5" FontWeight="Bold"
                                       TextWrapping="Wrap" Text="正在检测 Lunar Client…" />
                            <TextBlock x:Name="LabStatusDetail" FontSize="11" Opacity="0.62"
                                       Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="15" Text="" />
                        </StackPanel>
                    </Grid>

                    <!--  信息块：标签与值分两列，值过长时省略并用 ToolTip 显示全文  -->
                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            CornerRadius="5" Padding="14,12" Margin="6,0,6,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="目标版本"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,7" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LabVersion"
                                       FontSize="11.5" Margin="0,0,0,7"
                                       TextTrimming="CharacterEllipsis" Text="Lunar Client 1.8.9" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="物料目录"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,7" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LabCacheDir"
                                       FontSize="11.5" Margin="0,0,0,7"
                                       TextTrimming="CharacterEllipsis" Text=""
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Java"
                                       FontSize="11.5" Opacity="0.55" Margin="0,0,10,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LabJava"
                                       FontSize="11.5" TextTrimming="CharacterEllipsis" Text="启动后自动定位"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                    </Border>

                    <WrapPanel Margin="0,14,0,0">
                        <local:MyButton x:Name="BtnLaunch" Height="35" MinWidth="130" Margin="0,0,12,0"
                                        ColorType="Highlight" Text="启动 Lunar" Click="BtnLaunch_Click" />
                        <local:MyButton x:Name="BtnOpenRoot" Height="35" MinWidth="130" Margin="0,0,12,0"
                                        Text="打开物料目录" Click="BtnOpenRoot_Click" />
                        <local:MyButton x:Name="BtnCopyCommand" Height="35" MinWidth="130"
                                        Text="复制启动命令" Click="BtnCopyCommand_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <!--  说明  -->
            <local:MyCard Margin="0,15" Title="说明">
                <StackPanel Margin="20,40,20,18">
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="不经过 Lunar 启动器，由 PCL 直接拉起游戏进程。物料清单向 Lunar 服务端实时获取，正版验证使用你在 PCL 登录的微软账号，走的是 Lunar 客户端原本的通道。" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,10" Opacity="0.85"
                               Text="前置条件：本机已安装 Lunar Client 并至少启动过一次，让物料与 JRE 落盘。PCL 不会下载 Lunar 本体。" />

                    <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="6,0,6,0" Opacity="0.6" FontSize="11.5"
                               Text="当前未实现 Lunar 的本地 IPC 服务，好友与社交面板不可用；单人、多人、模组均正常。" />
                </StackPanel>
            </local:MyCard>

            <!--  运行日志  -->
            <local:MyCard Margin="0,15" Title="运行日志">
                <StackPanel Margin="20,40,20,18">
                    <Grid Margin="6,0,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.55"
                                   Text="启动阶段与游戏输出" />
                        <local:MyButton x:Name="BtnClearLog" Grid.Column="1" Height="24" MinWidth="60"
                                        Text="清空" Click="BtnClearLog_Click" />
                    </Grid>

                    <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                            CornerRadius="5" Padding="10">
                        <local:MyScrollViewer Height="230" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="TextLog" IsReadOnly="True" BorderThickness="0"
                                     Background="Transparent" FontFamily="Consolas" FontSize="11.5"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollBarVisibility="Disabled" />
                        </local:MyScrollViewer>
                    </Border>
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
