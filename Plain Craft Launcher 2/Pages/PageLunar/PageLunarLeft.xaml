<local:MyPageLeft x:Class="PCL.PageLunarLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:PCL"
                  mc:Ignorable="d">
    <!--
        文案暂时直接写中文：这是 nightly 里的实验特性，等协议稳定后再补四语言键，
        免得先加一堆键、后面改协议又要全删一遍。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <local:MyScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical" x:Name="PanItem" Margin="0,12,0,0">

                <TextBlock Text="LUNAR CLIENT"
                           Margin="13,5,5,3"
                           Opacity="0.6" FontSize="12" />

                <local:MyListItem x:Name="ItemLaunch"
                                  IsScaleAnimationEnabled="False"
                                  Type="RadioBox" Tag="0"
                                  Check="PageCheck"
                                  MinPaddingRight="35" Height="36"
                                  VerticalAlignment="Top"
                                  Title="启动"
                                  LogoScale="0.85"
                                  SvgIcon="lucide/play" />

                <TextBlock Text="状态"
                           Margin="13,10,5,4" Opacity="0.6" FontSize="12" />
                <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                        CornerRadius="5" Padding="12,11" Margin="0,0,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="ShapeStatusDot" Grid.Column="0"
                                     Width="8" Height="8" Margin="0,4,8,0"
                                     VerticalAlignment="Top"
                                     Fill="{DynamicResource ColorBrushGray4}" />
                            <TextBlock x:Name="LabStatus" Grid.Column="1"
                                       FontSize="13" FontWeight="Bold"
                                       TextWrapping="Wrap" MaxHeight="36"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                       Text="正在检测 Lunar Client…" />
                        </Grid>
                        <TextBlock x:Name="LabDetail" Text="" FontSize="10.5" Margin="16,4,0,0"
                                   TextWrapping="Wrap" MaxHeight="60" LineHeight="14"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   Opacity="0.62" />
                    </StackPanel>
                </Border>

                <TextBlock Text="账号"
                           Margin="13,12,5,4" Opacity="0.6" FontSize="12" />
                <Border Background="{DynamicResource ColorBrushTransparentBackground}"
                        CornerRadius="5" Padding="12,10">
                    <StackPanel>
                        <TextBlock x:Name="LabAccountName" Text=""
                                   FontSize="12.5" FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        <TextBlock x:Name="LabAccountHint" Text=""
                                   FontSize="10.5" Margin="0,4,0,0" LineHeight="15"
                                   TextWrapping="Wrap" Opacity="0.62" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </local:MyScrollViewer>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <local:MyButton x:Name="BtnLaunch" Height="54" Margin="20,0"
                            Text="启动 Lunar"
                            ColorType="Highlight"
                            Click="BtnLaunch_Click"
                            Padding="30,0,30,15" />
            <TextBlock x:Name="LabVersionText" Text="" Margin="35,0,35,10"
                       IsHitTestVisible="False"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11" Opacity="0.65" />
        </Grid>
    </Grid>
</local:MyPageLeft>
