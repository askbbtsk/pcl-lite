<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageSetupLauncherMisc"
    PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="{DynamicResource Setup.Misc.System.Title}">
                <Grid Margin="25,40,25,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.System.Announcement}" Margin="0,0,25,0"
                               Grid.Row="0" />
                    <local:MyComboBox x:Name="ComboSystemActivity" Tag="SystemSystemActivity" Grid.Column="1"
                                      Grid.Row="0"
                                      SelectionChanged="ComboSystemActivity_OnSelectionChanged">
                        <local:MyComboBoxItem Content="{DynamicResource Setup.Misc.System.Announcement.All}" ToolTip="{DynamicResource Setup.Misc.System.Announcement.All.ToolTip}" />
                        <local:MyComboBoxItem Content="{DynamicResource Setup.Misc.System.Announcement.ImportantOnly}" />
                        <local:MyComboBoxItem Content="{DynamicResource Setup.Misc.System.Announcement.Disabled}" />
                    </local:MyComboBox>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.System.MaxFps}"
                               Margin="0,0,25,0" />
                    <local:MySlider x:Name="SliderAniFPS" Grid.Row="2" Tag="UiAniFPS" MaxValue="59" Value="59"
                                    Grid.Column="1"
                                     ToolTip="{DynamicResource Setup.Misc.System.MaxFps.ToolTip}"
                                    Change="SliderChange" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.System.MaxLogLines}"
                               Margin="0,0,25,0" />
                    <local:MySlider x:Name="SliderMaxLog" Grid.Row="4" Tag="SystemMaxLog" MaxValue="29" Value="13"
                                    Grid.Column="1"
                                     ToolTip="{DynamicResource Setup.Misc.System.MaxLogLines.ToolTip}"
                                    Change="SliderChange" />
                    <Grid Grid.Row="6" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <local:MyCheckBox Grid.Row="0" Grid.Column="0" Text="{DynamicResource Setup.Misc.System.DisableHardwareAcceleration}" x:Name="CheckSystemDisableHardwareAcceleration" Tag="SystemDisableHardwareAcceleration" Change="CheckSystemDisableHardwareAcceleration_OnChange"/>
                    </Grid>
                    <Grid Grid.Row="8" Grid.ColumnSpan="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <local:MyButton Grid.Column="0" Grid.Row="0" x:Name="BtnSystemSettingExp" MinWidth="140"
                                        Text="{DynamicResource Setup.Misc.System.ExportSettings}" Padding="13,0" Margin="0,0,20,0"
                                        Click="BtnSystemSettingExp_Click" />
                        <local:MyButton Grid.Column="1" Grid.Row="0" x:Name="BtnSystemSettingImp" MinWidth="140"
                                        Text="{DynamicResource Setup.Misc.System.ImportSettings}" Padding="13,0" Margin="0,0,20,0"
                                        Click="BtnSystemSettingImp_Click" />
                        <local:MyButton Grid.Column="2" Grid.Row="0" x:Name="BtnSystemStopUsingPclCe" MinWidth="140"
                                        Text="{DynamicResource Setup.Misc.System.StopUsingPclCe}" Padding="13,0" Margin="0,0,20,0"
                                        ColorType="Red" Click="BtnSystemStopUsingPclCe_Click" />
                    </Grid>
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Setup.Misc.Network.Title}">
                <Grid Margin="25,38,25,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:MyCheckBox x:Name="CheckNetDohEnable" Tag="SystemNetEnableDoH" Grid.Row="0"
                                      Grid.ColumnSpan="2" Text="{DynamicResource Setup.Misc.Network.DoH}"
                                      ToolTip="{DynamicResource Setup.Misc.Network.DoH.ToolTip}"
                                      Change="CheckBoxChange" />
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.Network.HttpProxy}"
                               Margin="0,0,25,0" />
                    <Grid Grid.Row="2" Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="0.2*" />
                        </Grid.ColumnDefinitions>
                        <local:MyRadioBox Text="{DynamicResource Setup.Misc.Network.Proxy.None}" x:Name="RadioHttpProxyType0" Height="22"
                                          Tag="SystemHttpProxyType/0" Grid.Column="0"
                                          Check="RadioBoxChange" />
                        <local:MyRadioBox Text="{DynamicResource Setup.Misc.Network.Proxy.System}" x:Name="RadioHttpProxyType1" Height="22"
                                          Tag="SystemHttpProxyType/1" Grid.Column="1"
                                          Check="RadioBoxChange" />
                        <local:MyRadioBox Text="{DynamicResource Setup.Misc.Network.Proxy.Custom}" x:Name="RadioHttpProxyType2" Height="22"
                                          Tag="SystemHttpProxyType/2" Grid.Column="2"
                                          Check="RadioBoxChange" />
                    </Grid>
                    <Grid Grid.Row="4" Grid.Column="1" x:Name="HttpProxyCustom"
                          Visibility="{Binding ElementName=RadioHttpProxyType2,Path=Checked,Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyHint Text="{DynamicResource Setup.Misc.Network.Proxy.UntrustedWarning}" Grid.Row="0" Grid.ColumnSpan="5" Theme="Yellow" />
                        <local:MyTextBox x:Name="TextSystemHttpProxy" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5"
                                         Tag="SystemHttpProxy" HintText="比如 http://127.0.0.1:1080/"
                                         ToolTip="{DynamicResource Setup.Misc.Network.Proxy.InvalidWarning}" />
                        <TextBlock Grid.Column="0" Grid.Row="4" Text="{DynamicResource Setup.Misc.Network.Proxy.Username}" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Margin="0,0,5,0" />
                        <local:MyTextBox Grid.Column="1" Grid.Row="4" HintText="{DynamicResource Setup.Misc.Network.Proxy.Optional}" Tag="SystemHttpProxyCustomUsername"
                                         x:Name="TextSystemHttpProxyCustomUsername" Margin="0,0,5,0" />
                        <TextBlock Grid.Column="2" Grid.Row="4" Text="{DynamicResource Setup.Misc.Network.Proxy.Password}" VerticalAlignment="Center"
                                   HorizontalAlignment="Left" Margin="0,0,5,0" />
                        <local:MyTextBox Grid.Column="3" Grid.Row="4" HintText="{DynamicResource Setup.Misc.Network.Proxy.Optional}" Tag="SystemHttpProxyCustomPassword"
                                         x:Name="TextSystemHttpProxyCustomPassword" Margin="0,0,5,0" />
                        <local:MyButton Text="{DynamicResource Setup.Misc.Network.Proxy.Apply}" TextPadding="3" Grid.Row="4" Grid.Column="4"
                                        x:Name="BtnApplyHttpProxy" Click="ApplyHttpProxyBtn_OnClicked" />
                    </Grid>
                </Grid>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="网络授权">
                <StackPanel Margin="25,38,25,18">
                    <local:MyCheckBox x:Name="CheckAllowAllConsent"
                                      Text="授权全部连接"
                                      ToolTip="默认开启。所有网络用途与未登记域名一律放行，不再弹出授权窗口。&#xA;关掉之后回到「按用途逐个确认」的细粒度模式。"
                                      Change="AllowAllConsent_Change" />
                    <local:MyCheckBox x:Name="CheckSystemPrivacyMode" Tag="SystemPrivacyMode" Margin="0,7,0,0"
                                      Text="隐私模式"
                                      ToolTip="开启后不再弹出授权窗口，任何未列入白名单的网络用途都会被直接拒绝。"
                                      Change="CheckBoxChange" />
                    <TextBlock x:Name="LabConsentAllowAllHint" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}"
                               Text="当前已授权全部连接：不会拦截任何出站请求，也不会弹出授权窗口。&#xA;关掉上面的勾选即可回到按用途授权的模式。" />
                    <TextBlock x:Name="LabConsentGranularHint" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}" Visibility="Collapsed"
                               Text="每次联网前会按「用途」询问一次：一次确认覆盖该用途下的全部域名，不会逐个域名打扰。允许仅对本次会话有效，点击下方「允许」才会写入永久白名单。&#xA;启动器更新、版本下载、加载器元数据与加密 DNS 这四项默认已授权，其余用途一律先询问。" />
                    <StackPanel x:Name="PanConsentList" Margin="0,14,0,0" />
                    <StackPanel x:Name="PanConsentActions" Orientation="Horizontal" Margin="0,10,0,0">
                        <local:MyButton x:Name="BtnResetConsent" Text="清空白名单" Height="32" MinWidth="104"
                                        Padding="14,0" Click="ResetConsentBtn_OnClicked" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="MCP 服务（AI 控制接口）">
                <StackPanel Margin="25,38,25,18">
                    <local:MyCheckBox x:Name="CheckMcpEnabled"
                                      Text="启用 MCP 服务"
                                      ToolTip="开启后，本机的 AI 客户端（Claude、Cursor、Cherry Studio 等）可以连接到启动器，&#xA;帮你启动游戏、整理 mod、分析崩溃原因。&#xA;&#xA;只监听 127.0.0.1，外部网络无法访问。默认关闭。"
                                      Change="McpEnabled_Change" />

                    <TextBlock x:Name="LabMcpDisabledHint" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}"
                               Text="MCP 服务当前已关闭。开启后启动器会在本机开放一个 HTTP 接口，供 AI 客户端调用。" />

                    <StackPanel x:Name="PanMcpOptions" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="监听端口"
                                       Margin="0,0,20,0" />
                            <local:MyTextBox x:Name="TextMcpPort" Grid.Row="0" Grid.Column="1"
                                             HintText="38765"
                                             ToolTip="默认 38765。改完会自动重启服务；端口被占用时会启动失败并在这里提示。"
                                             TextChanged="McpPort_TextChanged" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="访问口令"
                                       Margin="0,0,20,0" />
                            <local:MyTextBox x:Name="TextMcpToken" Grid.Row="2" Grid.Column="1"
                                             HintText="可留空，留空表示不校验"
                                             ToolTip="留空时任何本机程序都能连上这个接口。&#xA;设了口令后，客户端必须在请求头带上 Authorization: Bearer &lt;口令&gt;。&#xA;口令加密保存在共享配置里，不会明文落到 config.v1.yml。"
                                             TextChanged="McpToken_TextChanged" />
                            <local:MyButton Grid.Row="2" Grid.Column="2" Text="随机生成" TextPadding="3"
                                            Margin="10,0,0,0" Click="BtnMcpRandomToken_Click" />

                            <Grid Grid.Row="4" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="CheckBox" />
                                </Grid.ColumnDefinitions>
                                <local:MyCheckBox Grid.Column="0" x:Name="CheckMcpAllowWrite"
                                                  Text="允许修改游戏文件"
                                                  ToolTip="允许 AI 在 mods 等目录里启用、禁用、移动、删除文件。&#xA;关掉后只能查看，不能改动。"
                                                  Change="McpPermission_Change" />
                                <local:MyCheckBox Grid.Column="1" x:Name="CheckMcpAllowGame"
                                                  Text="允许启动/停止游戏"
                                                  ToolTip="允许 AI 触发启动流程和强制结束游戏进程。"
                                                  Change="McpPermission_Change" />
                                <local:MyCheckBox Grid.Column="2" x:Name="CheckMcpAllowConfig"
                                                  Text="允许修改启动器设置"
                                                  ToolTip="允许 AI 通过接口读写启动器的配置项。风险较高，默认关闭。"
                                                  Change="McpPermission_Change" />
                            </Grid>

                            <TextBlock Grid.Row="6" Grid.ColumnSpan="3" x:Name="LabMcpStatus"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource ColorBrushGray2}" Text="状态：未启动" />

                            <Grid Grid.Row="8" Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                </Grid.ColumnDefinitions>
                                <local:MyButton Grid.Column="0" x:Name="BtnCopyMcpConfig" Text="复制连接配置"
                                                MinWidth="120" Padding="13,0" Margin="0,0,12,0"
                                                ToolTip="复制一段 JSON，直接粘进 AI 客户端的 MCP 配置文件即可。"
                                                Click="BtnCopyMcpConfig_Click" />
                                <local:MyButton Grid.Column="1" x:Name="BtnMcpRestart" Text="重启服务"
                                                MinWidth="100" Padding="13,0" Margin="0,0,12,0"
                                                Click="BtnMcpRestart_Click" />
                                <local:MyButton Grid.Column="2" x:Name="BtnMcpOpenFolder" Text="打开配置目录"
                                                MinWidth="120" Padding="13,0"
                                                Click="BtnMcpOpenFolder_Click" />
                            </Grid>
                        </Grid>

                        <TextBlock Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}"
                                   Text="把「复制连接配置」得到的内容粘进 AI 客户端的 mcpServers 里，重启客户端就能连上。&#xA;口令只在请求时校验，改完立刻生效，不需要重启服务。" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="Discord 状态显示（Rich Presence）">
                <StackPanel Margin="25,38,25,18">
                    <local:MyCheckBox x:Name="CheckDiscordEnabled"
                                      Text="在 Discord 个人资料里显示我在做什么"
                                      ToolTip="开启后，Discord 好友点开你的头像能看到：&#xA;· 你在启动器里，还是在玩 Minecraft&#xA;· 玩的是哪个版本、占多少内存&#xA;· 已经玩了多久&#xA;&#xA;状态直接发给本机 Discord 客户端，不经过任何第三方服务器。默认关闭。"
                                      Change="DiscordEnabled_Change" />

                    <TextBlock x:Name="LabDiscordDisabledHint" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}"
                               Text="当前已关闭。打开开关就能用，不需要额外配置——应用 ID 已经内置好了。" />

                    <StackPanel x:Name="PanDiscordOptions" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="应用 ID" Margin="0,0,20,0" />
                            <local:MyTextBox x:Name="TextDiscordAppId" Grid.Column="1"
                                             HintText="已内置官方应用 ID，一般不用改"
                                             ToolTip="默认已填好 PCL Lite 自己的 Discord 应用，开箱即用。&#xA;想换成自己的应用就替换成你的 Application ID（不是机器人 Token，填错不会泄露账号）。&#xA;清空则不会连接 Discord。"
                                             TextChanged="DiscordAppId_TextChanged" />
                            <local:MyButton Grid.Column="2" Text="开发者门户" TextPadding="3" Margin="10,0,0,0"
                                            ToolTip="打开 discord.com/developers/applications，点 New Application，名字随意。"
                                            Click="BtnDiscordPortal_Click" />
                        </Grid>

                        <TextBlock Margin="0,18,0,8" Text="显示内容（可多选）" />
                        <WrapPanel>
                            <local:MyCheckBox x:Name="CheckDiscordLauncherVersion" Margin="0,0,24,8"
                                              Text="启动器版本"
                                              ToolTip="未开游戏时，标题行显示 PCL Lite 与版本号。"
                                              Change="DiscordField_Change" />
                            <local:MyCheckBox x:Name="CheckDiscordLauncherMemory" Margin="0,0,24,8"
                                              Text="启动器内存"
                                              ToolTip="未开游戏时，显示启动器自身占用的内存。"
                                              Change="DiscordField_Change" />
                            <local:MyCheckBox x:Name="CheckDiscordGameVersion" Margin="0,0,24,8"
                                              Text="游戏版本"
                                              ToolTip="开游戏后，标题行显示实例名（如 1.20.1-Forge）。"
                                              Change="DiscordField_Change" />
                            <local:MyCheckBox x:Name="CheckDiscordGameMemory" Margin="0,0,24,8"
                                              Text="游戏内存"
                                              ToolTip="开游戏后，显示 Minecraft 进程占用的内存。"
                                              Change="DiscordField_Change" />
                            <local:MyCheckBox x:Name="CheckDiscordPlayTime" Margin="0,0,24,8"
                                              Text="游玩时长"
                                              ToolTip="开游戏后显示已游玩时长，未开游戏时显示启动器已运行多久。&#xA;时长由 Discord 自己跳动，不会额外增加上报频率。"
                                              Change="DiscordField_Change" />
                            <local:MyCheckBox x:Name="CheckDiscordServer" Margin="0,0,24,8"
                                              Text="服务器地址"
                                              ToolTip="从游戏日志里读当前连接的服务器地址。&#xA;打开后，任何能看到你 Discord 资料的人都会知道你在哪个服。默认关闭。"
                                              Change="DiscordField_Change" />
                        </WrapPanel>

                        <TextBlock x:Name="LabDiscordServerHint" Margin="0,0,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}"
                                   Text="服务器地址默认不显示：打开后好友能直接看到你在哪个服，只在你主动勾选时生效。" />

                        <TextBlock x:Name="LabDiscordStatus" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}" Text="状态：未启用" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton Grid.Column="0" Text="立即刷新" MinWidth="100" Padding="13,0" Margin="0,0,12,0"
                                            ToolTip="改完设置后如果 Discord 里没反应，点一下强制重发。"
                                            Click="BtnDiscordRefresh_Click" />
                            <local:MyButton Grid.Column="1" Text="在 Discord 中清除" MinWidth="130" Padding="13,0"
                                            ToolTip="立刻把状态从 Discord 上撤下来，但保持连接；之后再改任何设置会自动恢复。"
                                            Click="BtnDiscordClear_Click" />
                        </Grid>

                        <TextBlock Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource ColorBrushGray2}"
                                   Text="原理：启动器通过本机命名管道（discord-ipc-0）直接把状态交给 Discord 客户端，不联网、不经中转。&#xA;关掉这个开关会立刻断开并清除状态。" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard x:Name="CardDebug" Margin="0,0,0,15" Title="{DynamicResource Setup.Misc.Debug.Title}" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanDebugAnim" Height="22" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="{DynamicResource Setup.Misc.Debug.AnimationSpeed}" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDebugAnim" Tag="SystemDebugAnim" MaxValue="30" Grid.Column="1"
                                        Change="SliderChange" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <local:MyCheckBox Grid.Column="0" Text="{DynamicResource Setup.Misc.Debug.SkipCopy}" Height="22"
                                          x:Name="CheckDebugSkipCopy" Tag="SystemDebugSkipCopy"
                                          ToolTip="{DynamicResource Setup.Misc.Debug.SkipCopy.ToolTip}"
                                          Change="CheckBoxChange" />
                        <local:MyCheckBox Grid.Column="1" Text="{DynamicResource Setup.Misc.Debug.Mode}" Height="22" x:Name="CheckDebugMode"
                                          Tag="SystemDebugMode" ToolTip="{DynamicResource Setup.Misc.Debug.Mode.ToolTip}"
                                          Change="CheckDebugMode_OnChange" />
                        <local:MyCheckBox Grid.Column="2" Text="{DynamicResource Setup.Misc.Debug.Delay}" Height="22" x:Name="CheckDebugDelay"
                                          Tag="SystemDebugDelay"
                                          ToolTip="{DynamicResource Setup.Misc.Debug.Delay.ToolTip}"
                                          Change="CheckBoxChange" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>