<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    xmlns:val="https://ce.pclc.cc/core/utils/validate"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PCL.PageSetupLunar"
    PanScroll="{Binding ElementName=PanBack, Mode=OneWay}">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!-- ① Java 运行环境 -->
            <local:MyCard Margin="0,15" Title="Java 运行环境">
                <Grid Margin="25,40,25,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="java.exe" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextJavaPath" Grid.Row="0" Grid.Column="1"
                                     HintText="留空 = 使用 Lunar 自带的 JRE"
                                     ValidatedTextChanged="TextJavaPath_OnChanged"
                                     ToolTip="Lunar 会按版本自己下 JRE（1.8.9 要 17、1.21 要 21、26.x 要 25）。只有想换成本机已装的其他 JRE 时才需要填这里。"
                                     Margin="0,0,10,0" />
                    <local:MyIconTextButton x:Name="BtnBrowseJava" Grid.Row="0" Grid.Column="2"
                                            Text="选择" LogoScale="0.9" SvgIcon="lucide/folder-open"
                                            Click="BtnBrowseJava_Click" />

                    <local:MyHint x:Name="HintJava" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,9,0,0"
                                  Theme="Yellow" Visibility="Collapsed" Text="" />
                </Grid>
            </local:MyCard>

            <!-- ② 全局内存与 JVM 参数 -->
            <local:MyCard Margin="0,15" Title="内存与 JVM 参数（全局）">
                <Grid Margin="25,40,25,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <local:MyCheckBox x:Name="CheckFollowGlobal" Grid.Row="0" Grid.ColumnSpan="2"
                                      Text="跟随 PCL 的全局内存设置"
                                      Change="CheckFollowGlobal_OnChange" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="最大内存（MB）" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextMemory" Grid.Row="2" Grid.Column="1"
                                     HintText="例如 4096"
                                     ValidatedTextChanged="TextMemory_OnChanged"
                                     ToolTip="留给游戏堆的容量。低于 512 会被自动抬到 512，上限 131072。">
                        <local:MyTextBox.ValidateRules>
                            <val:IntValidator Min="512" Max="131072" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>

                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,12,0,6">
                        <TextBlock Text="附加 JVM 参数" VerticalAlignment="Center" />
                        <local:MyIconButton Height="23" Margin="6,1,0,0" VerticalAlignment="Center"
                                            x:Name="BtnResetJvm" Click="BtnResetJvm_Click"
                                            ToolTip="清空" ToolTipService.Placement="Right"
                                            ToolTipService.InitialShowDelay="200" ToolTipService.VerticalOffset="-1"
                                            SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                    </StackPanel>
                    <local:MyTextBox x:Name="TextJvm" Grid.Row="5" Grid.ColumnSpan="2"
                                     Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" Padding="0,5"
                                     VerticalScrollBarVisibility="Auto" MaxLength="4000"
                                     HintText="例如 -XX:+UseG1GC -XX:+AlwaysPreTouch"
                                     ValidatedTextChanged="TextJvm_OnChanged"
                                     ToolTip="会被拼在 Lunar 按版本下发的 JVM 参数之后。JVM 对重复参数取最后一次，所以这里的 -Xmx、-XX:+UseZGC 之类会盖掉官方值。支持用引号把带空格的参数括起来。" />
                </Grid>
            </local:MyCard>

            <!-- ③ 按版本覆盖 -->
            <local:MyCard Margin="0,15" Title="按版本覆盖">
                <Grid Margin="25,40,25,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Text="版本" Margin="0,0,25,0" />
                    <local:MyComboBox x:Name="ComboVersion" Grid.Row="0" Grid.Column="1"
                                      SelectionChanged="ComboVersion_OnSelectionChanged" />

                    <local:MyCheckBox x:Name="CheckVersionOverride" Grid.Row="1" Grid.ColumnSpan="2"
                                      Margin="0,9,0,0"
                                      Text="为这个版本单独设置内存与 JVM 参数"
                                      Change="CheckVersionOverride_OnChange" />

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" x:Name="PanVersionOptions" Margin="0,12,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="Margin" Value="0,0,25,0" />
                            </Style>
                        </StackPanel.Resources>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="9" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="最大内存（MB）" />
                            <local:MyTextBox x:Name="TextVersionMemory" Grid.Row="0" Grid.Column="1"
                                             HintText="留空 = 沿用全局"
                                             ValidatedTextChanged="TextVersionMemory_OnChanged"
                                             ToolTip="只影响下拉框里选中的这个版本。">
                                <local:MyTextBox.ValidateRules>
                                    <val:IntValidator Min="512" Max="131072" />
                                </local:MyTextBox.ValidateRules>
                            </local:MyTextBox>

                            <TextBlock Grid.Row="2" Text="附加 JVM 参数" Margin="0,12,25,6" />
                            <local:MyTextBox x:Name="TextVersionJvm" Grid.Row="2" Grid.Column="1"
                                             Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top" Padding="0,5"
                                             VerticalScrollBarVisibility="Auto" MaxLength="4000"
                                             HintText="留空 = 沿用全局"
                                             ValidatedTextChanged="TextVersionJvm_OnChanged" />
                        </Grid>
                    </StackPanel>

                    <local:MyHint x:Name="HintEffective" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,14,0,0"
                                  Theme="Blue" Text="" />
                </Grid>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
