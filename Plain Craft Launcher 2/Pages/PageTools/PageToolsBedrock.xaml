<local:MyPageRight x:Class="PCL.PageToolsBedrock"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="{DynamicResource Tools.Bedrock.Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{DynamicResource Tools.Bedrock.Description}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,15,0,0" ItemHeight="35">
                        <local:MyButton x:Name="BtnRefresh" MinWidth="110" Margin="0,0,12,0"
                                        Text="{DynamicResource Tools.Bedrock.Refresh}" Click="BtnRefresh_Click" />
                        <local:MyButton x:Name="BtnStop" MinWidth="130" Margin="0,0,12,0"
                                        Text="{DynamicResource Tools.Bedrock.Stop}" Click="BtnStop_Click" />
                        <local:MyButton x:Name="BtnAddFolder" MinWidth="130" Margin="0,0,12,0"
                                        Text="{DynamicResource Tools.Bedrock.AddFolder}" Click="BtnAddFolder_Click" />
                        <local:MyButton x:Name="BtnOpenSaves" MinWidth="130"
                                        Text="{DynamicResource Tools.Bedrock.OpenSaves}" Click="BtnOpenSaves_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="LabStatus" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap" Opacity="0.7" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Tools.Bedrock.List.Title}">
                <StackPanel Margin="20,40,20,15">
                    <ItemsControl x:Name="ListInstalls">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="54">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="6,0,12,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,3,0,0" FontSize="11.5" Opacity="0.65"
                                                   Text="{Binding Info}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <local:MyButton Grid.Column="1" Width="90" Height="30" VerticalAlignment="Center"
                                                    ColorType="Highlight" Text="{DynamicResource Tools.Bedrock.Launch}"
                                                    Tag="{Binding Install}" Click="BtnLaunch_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="LabEmpty" Margin="6,10" Opacity="0.7" TextWrapping="Wrap"
                               Text="{DynamicResource Tools.Bedrock.Empty}" Visibility="Collapsed" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
