<local:MyPageRight x:Class="PCL.PageToolsDirectLink"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL"
                   PanScroll="{Binding ElementName=PanBack}">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="PanMain" Margin="25,10">

            <!-- 仅在没检测到公网 IPv6 时显示，不占用正常情况的版面 -->
            <local:MyCard x:Name="CardNoIpv6" Margin="0,15,0,15" Visibility="Collapsed"
                          Title="{DynamicResource Link.Env.NoIpv6Title}">
                <StackPanel Margin="25,40,25,20">
                    <TextBlock Text="{DynamicResource Link.Env.NoIpv6Desc}" TextWrapping="Wrap" LineHeight="20" />
                    <WrapPanel Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnRetryIpv6" MinWidth="130" Height="35"
                                        Text="{DynamicResource Link.Left.RefreshNet}"
                                        Click="BtnRetryIpv6_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>

            <!-- 房主视图 -->
            <StackPanel x:Name="PanHostMode" Margin="0,15,0,0">
                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Link.Host.Step1Title}">
                    <StackPanel Margin="25,40,25,20">
                        <TextBlock x:Name="LabLanDetected" TextWrapping="Wrap" LineHeight="20"
                                   Text="{DynamicResource Link.Host.LanWaiting}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Text="{DynamicResource Link.Host.PortLabel}" />
                            <local:MyTextBox x:Name="TextHostPort" Grid.Column="1" Text="25565"
                                             TextChanged="TextHostPort_TextChanged" />
                            <local:MyButton x:Name="BtnHostToggle" Grid.Column="2" HorizontalAlignment="Left"
                                            MinWidth="190" Height="35" Margin="12,0,0,0" ColorType="Highlight"
                                            Text="{DynamicResource Link.Host.StartBtn}"
                                            Click="BtnHostToggle_Click" />
                        </Grid>

                        <StackPanel x:Name="PanHostInviteRow" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="LabHostAuthMode" Margin="0,0,0,6" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" />
                            <TextBlock Text="{DynamicResource Link.Host.InviteHint}" TextWrapping="Wrap" Opacity="0.82" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextInviteCode" Grid.Column="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                                <local:MyButton x:Name="BtnCopyInvite" Grid.Column="1" MinWidth="95" Height="35" Margin="10,0,0,0"
                                                Text="{DynamicResource Link.Host.CopyAgain}"
                                                Click="BtnCopyInvite_Click" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard x:Name="CardHostAck" Margin="0,0,0,15" Visibility="Collapsed"
                              Title="{DynamicResource Link.Host.Step2Title}">
                    <StackPanel Margin="25,40,25,20">
                        <TextBlock Text="{DynamicResource Link.Host.AckDesc}" TextWrapping="Wrap" LineHeight="20" Opacity="0.82" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TextHostAckInput" Grid.Column="0"
                                             HintText="{DynamicResource Link.Host.AckPlaceholder}" />
                            <local:MyButton x:Name="BtnAcceptAck" Grid.Column="1" MinWidth="120" Height="35" Margin="10,0,0,0"
                                            ColorType="Highlight"
                                            Text="{DynamicResource Link.Host.PasteAndAccept}"
                                            Click="BtnAcceptAck_Click" />
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard x:Name="CardHostPeers" Margin="0,0,0,20" Visibility="Collapsed"
                              Title="{DynamicResource Link.Host.PeersTitle}">
                    <StackPanel Margin="25,40,25,20">
                        <TextBlock x:Name="LabHostPeers" TextWrapping="Wrap" LineHeight="22"
                                   Text="{DynamicResource Link.Host.NoPeers}" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>

            <!-- 房客视图 -->
            <StackPanel x:Name="PanGuestMode" Margin="0,15,0,0" Visibility="Collapsed">
                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Link.Guest.Step1Title}">
                    <StackPanel Margin="25,40,25,20">
                        <TextBlock Text="{DynamicResource Link.Guest.InviteHint}" TextWrapping="Wrap" LineHeight="20" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyTextBox x:Name="TextGuestInviteInput" Grid.Column="0"
                                             HintText="{DynamicResource Link.Guest.InvitePlaceholder}" />
                            <local:MyButton x:Name="BtnGuestToggle" Grid.Column="1" MinWidth="125" Height="35" Margin="10,0,0,0"
                                            ColorType="Highlight"
                                            Text="{DynamicResource Link.Guest.PasteAndConnect}"
                                            Click="BtnGuestToggle_Click" />
                        </Grid>
                    </StackPanel>
                </local:MyCard>

                <local:MyCard x:Name="CardGuestProgress" Margin="0,0,0,20" Visibility="Collapsed"
                              Title="{DynamicResource Link.Guest.Step2Title}">
                    <StackPanel Margin="25,40,25,20">
                        <TextBlock x:Name="LabGuestStatus" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="20"
                                   Text="{DynamicResource Link.Guest.Connecting}" />

                        <StackPanel x:Name="PanGuestAck" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Link.Guest.AckExplain}" TextWrapping="Wrap" LineHeight="20" Opacity="0.85" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <local:MyTextBox x:Name="TextGuestAckCode" Grid.Column="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" />
                                <local:MyButton x:Name="BtnCopyGuestAck" Grid.Column="1" MinWidth="105" Height="35" Margin="10,0,0,0"
                                                ColorType="Highlight"
                                                Text="{DynamicResource Link.Guest.CopyAck}"
                                                Click="BtnCopyGuestAck_Click" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="PanGuestConnected" Margin="0,14,0,0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource Link.Guest.FallbackAddrHint}" TextWrapping="Wrap" LineHeight="20" Opacity="0.82" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="35" Padding="10,0" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource ColorBrush8}"
                                        BorderBrush="{DynamicResource ColorBrush6}"
                                        Cursor="Hand"
                                        ToolTip="只读地址，点击右侧按钮或此处复制"
                                        MouseLeftButtonUp="BtnCopyLocalAddr_Click">
                                    <TextBlock x:Name="TextLocalAddr" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource ColorBrush1}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <local:MyButton x:Name="BtnCopyLocalAddr" Grid.Column="1" MinWidth="105" Height="35" Margin="10,0,0,0"
                                                Text="{DynamicResource Link.Guest.CopyAddr}"
                                                Click="BtnCopyLocalAddr_Click" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
