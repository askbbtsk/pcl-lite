<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:PCL">
    <SolidColorBrush x:Key="TahoeText">#252830</SolidColorBrush>
    <SolidColorBrush x:Key="TahoeSecondaryText">#5D626D</SolidColorBrush>
    <SolidColorBrush x:Key="TahoeSidebarSection">#52FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="TahoeFieldSurface">White</SolidColorBrush>
    <SolidColorBrush x:Key="TahoeFieldBorder">#30000000</SolidColorBrush>
    <SolidColorBrush x:Key="TahoeAccent">#007AFF</SolidColorBrush>
    <SolidColorBrush x:Key="TahoeActionText">#003B7A</SolidColorBrush>

    <Style x:Key="TahoeSidebarSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColorBrushTransparentBackground}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="12,10" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:TahoeThemeManager.Appearance}}" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Margin" Value="10,0,10,0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,10" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TahoeSidebarHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray1}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="13,10,5,4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:TahoeThemeManager.Appearance}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TahoeSecondaryText}" />
                <Setter Property="Opacity" Value="1" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="22,16,18,4" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TahoeSidebarPathStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray1}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Opacity" Value="0.62" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:TahoeThemeManager.Appearance}}" Value="True">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Foreground" Value="{DynamicResource TahoeSecondaryText}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TahoeInsetFormStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ColorBrushTransparentBackground}" />
        <Setter Property="CornerRadius" Value="5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:TahoeThemeManager.Appearance}}" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TahoeEmptyTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrush3}" />
        <Setter Property="FontSize" Value="19" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:TahoeThemeManager.Appearance}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TahoeText}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TahoeEmptyRuleStyle" TargetType="Rectangle">
        <Setter Property="Fill" Value="{DynamicResource ColorBrush3}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:TahoeThemeManager.Appearance}}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TahoeLaunchSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray1}" />
        <Setter Property="Opacity" Value="0.65" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, Source={x:Static local:TahoeThemeManager.Appearance}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource TahoeActionText}" />
                <Setter Property="Opacity" Value="0.85" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TahoeHomeLaunchSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TahoeLaunchSubtitleStyle}">
        <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray3}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
</ResourceDictionary>
